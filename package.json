{
  "name": "spotify-wrapper",
  "version": "2.0.0",
  "description": "A lightweight TypeScript client for Spotify Web API search.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node --eval \"import('node:fs/promises').then(fs => fs.rm('dist', { recursive: true, force: true }))\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-denner/spotify-wrapper.git"
  },
  "keywords": [
    "spotify",
    "spotify-web-api",
    "api-client",
    "typescript",
    "library"
  ],
  "author": "Denner Fernandes <dev.denner@outlook.com> (https://github.com/dev-denner)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dev-denner/spotify-wrapper/issues"
  },
  "homepage": "https://github.com/dev-denner/spotify-wrapper#readme",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
